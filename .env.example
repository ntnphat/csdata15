# Sao chep file nay thanh .env va dien thong tin that
# KHONG commit file .env len GitHub

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# --- Tro ly AI ---
# Cach 1 - OpenAI (tra phi): platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Cach 2 - Dich vu tuong thich chuan OpenAI, co goi mien phi.
# Chi can doi 3 dong tren, khong sua ma nguon:
#   Groq       -> OPENAI_BASE_URL=https://api.groq.com/openai/v1
#                 OPENAI_MODEL=llama-3.3-70b-versatile
#   OpenRouter -> OPENAI_BASE_URL=https://openrouter.ai/api/v1
#                 OPENAI_MODEL=<model co duoi :free>

OPENAI_EMBEDDING_MODEL=text-embedding-3-small

APP_ENV=local

# Email duoc vao trang Quan tri du lieu, cach nhau bang dau phay.
# De trong = chi mo khi APP_ENV=local.
ADMIN_EMAILS=
